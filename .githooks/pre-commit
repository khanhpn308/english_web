#!/bin/sh
set -eu

for required_tool in git python npm; do
    if ! command -v "$required_tool" >/dev/null 2>&1; then
        printf 'pre-commit: required tool %s is unavailable.\n' "$required_tool" >&2
        exit 2
    fi
done

t045_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 2
cd "$t045_root"

# Git's whitespace diagnostics can include the offending source line.
if ! git diff --cached --check --no-ext-diff --no-textconv >/dev/null 2>&1; then
    printf '%s\n' 'pre-commit: staged whitespace or diff error; commit blocked.' >&2
    exit 1
fi

# Python is already required by the repository's npm quality/security commands.
python - <<'PY'
import os
from pathlib import Path, PurePosixPath
import shutil
import subprocess
import sys
import tempfile


def reject(message, code=1):
    print(f"pre-commit: {message}", file=sys.stderr)
    raise SystemExit(code)


def git(*arguments, data=None, allowed=(0,)):
    result = subprocess.run(
        ["git", *arguments], input=data, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
    )
    if result.returncode not in allowed:
        reject("Git inspection failed; commit blocked.", 2)
    return result


def gate(command, directory, environment):
    result = subprocess.run(
        [npm, "run", command], cwd=directory, env=environment,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    if result.returncode:
        reject(f"npm run {command} failed or tooling is missing; commit blocked.")


try:
    repo = Path.cwd()
    npm = shutil.which("npm")
    if npm is None or sys.version_info < (3, 12):
        reject("npm and Python 3.12+ are required.", 2)

    index_before = git("ls-files", "--stage", "-z").stdout
    # shortcut: snapshots support regular files only; add safe link handling if adopted.
    for entry in index_before.split(b"\0"):
        if entry:
            metadata, _path = entry.split(b"\t", 1)
            mode, _object, stage = metadata.split()
            if stage != b"0" or mode not in {b"100644", b"100755"}:
                reject("unmerged entries, symlinks or submodules require separate handling.")

    staged = git("diff", "--cached", "--name-only", "--diff-filter=ACMRT", "-z").stdout
    ignored = git("check-ignore", "--no-index", "--stdin", "-z", data=staged, allowed=(0, 1))
    if ignored.returncode == 0:
        reject("staged files match ignore rules; remove private data/build output from the index.")

    private_directories = {
        "browser-profiles", "browser_profiles", "browser-profile", "browser_profile",
        "chrome-profile", "chrome_profile", "edge-profile", "edge_profile", "user data", ".auth",
    }
    private_files = {
        "cookies", "login data", "local state", "web data",
        "storage-state.json", "storage_state.json", "auth-state.json", "auth_state.json",
    }
    for raw_path in staged.split(b"\0"):
        if not raw_path:
            continue
        path = PurePosixPath(os.fsdecode(raw_path).casefold())
        name = path.name.removesuffix("-wal").removesuffix("-shm").removesuffix("-journal")
        if (
            private_directories.intersection(path.parts) or name in private_files
            or name.endswith((".db", ".sqlite", ".sqlite3", ".pem", ".key", ".dpapi", ".secret", ".token"))
            or (name == ".env" or name.startswith(".env.") and name != ".env.example")
        ):
            reject("staged credentials, database or browser data are forbidden.")

    dependencies = repo / "node_modules"
    if not dependencies.is_dir():
        reject("installed locked frontend dependencies are required; no automatic install.", 2)

    environment = os.environ.copy()
    snapshot_environment = environment.copy()
    snapshot_environment["GIT_DIR"] = os.fsdecode(git("rev-parse", "--absolute-git-dir").stdout).strip()
    index_path = Path(os.fsdecode(git("rev-parse", "--git-path", "index").stdout).strip())
    snapshot_environment["GIT_INDEX_FILE"] = str(index_path.absolute())
    with tempfile.TemporaryDirectory(prefix="vocabulary-pre-commit-") as temporary:
        snapshot = Path(temporary)
        git("checkout-index", "--all", f"--prefix={snapshot.as_posix()}/")
        snapshot_environment["GIT_WORK_TREE"] = str(snapshot)
        if os.name == "nt":
            link_environment = environment.copy()
            link_environment["T045_SNAPSHOT_DEPS"] = str(snapshot / "node_modules")
            link_environment["T045_WORKTREE_DEPS"] = str(dependencies)
            linked = subprocess.run(
                ["cmd.exe", "/d", "/v:off", "/c",
                 'mklink /J "%T045_SNAPSHOT_DEPS%" "%T045_WORKTREE_DEPS%"'],
                env=link_environment, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            if linked.returncode:
                reject("cannot link installed dependencies into the staged snapshot.", 2)
        else:
            (snapshot / "node_modules").symlink_to(dependencies, target_is_directory=True)

        # check:fast already composes this quality gate with security:secrets.
        gate("check:fast:active", snapshot, snapshot_environment)
        if git("rev-parse", "--verify", "HEAD", allowed=(0, 128)).returncode:
            # The existing scanner has no staged mode before the first commit.
            gate("security:secrets", snapshot, snapshot_environment)

    gate("security:secrets", repo, environment)
    if git("ls-files", "--stage", "-z").stdout != index_before:
        reject("the index changed during checks; inspect staging and retry the commit.")
except (OSError, ValueError):
    reject("required tooling or staged snapshot setup failed; commit blocked.", 2)
PY
