                "type": "string"
              },
              "snapshotRevision": {
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "attemptId",
              "guidanceCode"
            ],
            "type": "object"
          },
          {
            "properties": {
              "consentState": {
                "enum": [
                  "NOT_GRANTED",
                  "GRANTED",
                  "REVOKED",
                  "STALE"
                ],
                "type": "string"
              },
              "currentPolicyVersion": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "AI_CONSENT"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "consentState"
            ],
            "type": "object"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
