{
  "components": {
    "schemas": {
      "BootstrapExchange": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "BootstrapExchange",
        "type": "object"
      },
      "BridgeStatus": {
        "description": "AI bridge adapter status.",
        "enum": [
          "NOT_CHECKED",
          "OK",
          "NOT_READY"
        ],
        "title": "BridgeStatus",
        "type": "string"
      },
      "ErrorDetails": {
        "anyOf": [
          {
            "properties": {
              "fields": {
                "items": {
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "reason"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "kind": {
                "enum": [
                  "FIELD_ERRORS"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "fields"
            ],
            "type": "object"
          },
          {
            "properties": {
              "currentRevision": {
                "type": "integer"
              },
              "expectedRevision": {
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "CONFLICT"
                ],
                "type": "string"
              },
              "resourceId": {
                "type": "string"
              },
              "resourceType": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "expectedRevision",
              "currentRevision"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "RETRY"
                ],
                "type": "string"
              },
              "operationId": {
                "type": "string"
              },
              "operationKind": {
                "type": "string"
              },
              "retryAfterSeconds": {
                "type": "integer"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "RESOURCE"
                ],
                "type": "string"
              },
              "recovery": {
                "enum": [
                  "READ",
                  "REBOOTSTRAP",
                  "RELINK",
                  "RESTORE"
                ],
                "type": "string"
              },
              "resourceId": {
                "type": "string"
              },
              "resourceType": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "resourceType",
              "recovery"
            ],
            "type": "object"
