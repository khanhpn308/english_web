            "title": "Errorcategory"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "operationId": {
            "title": "Operationid",
            "type": "string"
          },
          "resultRef": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resultref"
          },
          "status": {
            "enum": [
              "PENDING",
              "SUCCEEDED",
              "FAILED",
              "UNKNOWN"
            ],
            "title": "Status",
            "type": "string"
          },
          "updatedAt": {
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "kind",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "title": "Operation",
        "type": "object"
      },
